# Sample production settings. This file is only a list of the variables production needs.
# Do not copy it to .env: production does not read .env. Set each variable in the deployment
# environment (secrets manager or hosting platform) and replace every placeholder below.
# Local development uses .env.example instead.

# Server. 0.0.0.0 lets the container accept traffic from the platform's load balancer.
HOST=0.0.0.0
PORT=5000
NODE_ENV=production

# Public origins. Both must use HTTPS in production, with no path. The app and the API must be
# on the same site (for example app.example.com and api.example.com) so the session cookie works.
BETTER_AUTH_URL=https://api.example.com
CLIENT_URL=https://app.example.com
# Random secret of at least 32 characters. Keep it stable between restarts, or sessions end.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-of-32-or-more-characters
# Google Web application OAuth credentials.
# Authorized redirect URI: https://api.example.com/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-web-client-id
GOOGLE_CLIENT_SECRET=your-google-web-client-secret

# Hosted PostgreSQL (for example Neon). Set DATABASE_URL only, never together with the DB_* values.
# sslmode must be require, verify-ca or verify-full. With Neon, use the pooled connection
# string (the host contains "-pooler") for the app.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=verify-full
# Only needed when DATABASE_URL uses transaction pooling: a direct or session-pooled URL
# that the migration runner uses instead. It must also use sslmode=require or stronger.
# MIGRATION_DATABASE_URL=postgresql://user:password@direct-host/dbname?sslmode=verify-full

# Connection pool tuning (optional, shown with the defaults).
# DB_POOL_MAX=10
# DB_CONNECTION_TIMEOUT_MS=10000
# DB_IDLE_TIMEOUT_MS=30000
# DB_STATEMENT_TIMEOUT_MS=30000

# Amazon S3 for uploaded source files. Leave S3_ENDPOINT unset: it is only for S3-compatible
# servers such as the local SeaweedFS. Give the access key only the s3:PutObject and
# s3:DeleteObject permissions on this bucket.
S3_BUCKET=your-bucket-name
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key

# Largest accepted source file in megabytes (optional, shown with the default).
# UPLOAD_MAX_FILE_MB=20
