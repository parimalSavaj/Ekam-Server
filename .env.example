# Required settings. Copy to .env for local development and set each value.
# Production must supply these through its deployment environment, not .env.
HOST=127.0.0.1
PORT=5000
NODE_ENV=development

# PostgreSQL. The root docker-compose.yml reads these same values:
#   docker compose --env-file server/.env up -d
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
