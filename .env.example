# Required settings. Copy to .env for local development and set each value.
# Production must supply these through its deployment environment, not .env.
HOST=127.0.0.1
PORT=5000
NODE_ENV=development

# Google-only authentication. Never expose secrets in client configuration.
BETTER_AUTH_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000
# Generate a random secret with at least 32 characters.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-before-starting
GOOGLE_CLIENT_ID=your-google-web-client-id
GOOGLE_CLIENT_SECRET=your-google-web-client-secret
# Google authorized redirect URI: http://localhost:5000/api/auth/callback/google
# Hosted DB: use a direct/session-pooled URL here if DATABASE_URL uses transaction pooling.
# MIGRATION_DATABASE_URL=postgresql://user:password@direct-host/dbname?sslmode=verify-full

# PostgreSQL, option 1: local Docker database (make start in the repository root).
# COMPOSE_PROFILES starts the local PostgreSQL container. Remove it when using option 2.
# Add local-storage (comma separated) to also start the local MinIO container, see below.
# The root docker-compose.yml reads these same values. All five are required.
# Inside Docker, DB_HOST is set automatically and DB_PORT is also used as the
# port PostgreSQL listens on.
COMPOSE_PROFILES=local-db
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# PostgreSQL, option 2: hosted database such as Neon (production).
# Set only DATABASE_URL and remove COMPOSE_PROFILES and the five DB_* values above.
# Setting both DATABASE_URL and DB_* fails startup.
# Production requires sslmode=require (or verify-ca / verify-full) in the URL.
# Prefer sslmode=verify-full: with sslmode=require the pg driver prints a warning
# about changed semantics in its next major version.
# With Neon, use the pooled connection string (host contains "-pooler") for the app.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=verify-full

# Connection pool tuning (optional, shown with the defaults).
# Keep DB_POOL_MAX small on a free hosted tier. DB_CONNECTION_TIMEOUT_MS must allow
# for a suspended hosted database to wake up.
# DB_POOL_MAX=10
# DB_CONNECTION_TIMEOUT_MS=10000
# DB_IDLE_TIMEOUT_MS=30000
# DB_STATEMENT_TIMEOUT_MS=30000

# Object storage for uploaded source files (PDFs and text files). The four S3_* values are required.
# Option 1: local SeaweedFS container (S3-compatible). Add local-storage to COMPOSE_PROFILES
# (comma separated, for example COMPOSE_PROFILES=local-db,local-storage) and run make start.
# The container is created with this access key and secret, and creates the bucket on start.
# Setting S3_ENDPOINT also makes the server use path-style addressing. Inside Docker the
# endpoint is replaced by the seaweedfs service automatically.
S3_BUCKET=ekam-local
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your_storage_key
S3_SECRET_ACCESS_KEY=your_storage_secret
S3_ENDPOINT=http://127.0.0.1:8333
# Ports of the local storage container on your machine (optional, shown with the defaults):
# the S3 API and the Filer UI (browse files at http://localhost:8888/buckets/<S3_BUCKET>/).
# If you change S3_PORT, change the port in S3_ENDPOINT to match.
# S3_PORT=8333
# S3_FILER_PORT=8888
#
# Option 2: Amazon S3 (production). Remove S3_ENDPOINT and local-storage from COMPOSE_PROFILES,
# and give the access key only the s3:PutObject and s3:DeleteObject permissions on the bucket.
# S3_BUCKET=your-bucket-name
# S3_REGION=ap-south-1

# Largest accepted source file in megabytes (optional, shown with the default).
# UPLOAD_MAX_FILE_MB=20
