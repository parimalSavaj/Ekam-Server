{
  "name": "ekam-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node --enable-source-maps dist/server.js",
    "db:create-migration": "tsx scripts/database/create-migration.ts",
    "db:migrate": "tsx scripts/database/migrate.ts",
    "db:status": "tsx scripts/database/migrate.ts --status",
    "typecheck:scripts": "tsc --project tsconfig.scripts.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "better-auth": "1.7.13",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.5.0",
    "pg": "8.23.1",
    "uuid": "14.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22",
    "@types/pg": "8.23.1",
    "tsx": "^4.23.5",
    "typescript": "^5"
  }
}
